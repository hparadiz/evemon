set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

if("$ENV{EVEMON_ANDROID_SYSROOT}" STREQUAL "")
    message(FATAL_ERROR "EVEMON_ANDROID_SYSROOT must be set to the local ARM64 sysroot")
endif()
if("$ENV{EVEMON_ANDROID_CC}" STREQUAL "")
    message(FATAL_ERROR "EVEMON_ANDROID_CC must be set to the local cross compiler")
endif()

file(TO_CMAKE_PATH "$ENV{EVEMON_ANDROID_SYSROOT}" EVEMON_CROSS_ROOT)
file(TO_CMAKE_PATH "$ENV{EVEMON_ANDROID_CC}" EVEMON_CROSS_CC)
set(CMAKE_SYSROOT "${EVEMON_CROSS_ROOT}")
set(CMAKE_C_COMPILER "${EVEMON_CROSS_CC}")
set(CMAKE_C_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_C_COMPILER_EXTERNAL_TOOLCHAIN "${EVEMON_CROSS_ROOT}/usr")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")

set(CMAKE_FIND_ROOT_PATH "${EVEMON_CROSS_ROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${EVEMON_CROSS_ROOT}")
set(ENV{PKG_CONFIG_LIBDIR}
    "${EVEMON_CROSS_ROOT}/usr/lib/aarch64-linux-gnu/pkgconfig:${EVEMON_CROSS_ROOT}/usr/share/pkgconfig")
