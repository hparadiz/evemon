set(NVTOP_DIR "${CMAKE_CURRENT_SOURCE_DIR}/third_party/nvtop")
if(NOT EXISTS "${NVTOP_DIR}/src/extract_gpuinfo.c")
    message(FATAL_ERROR "GPU support requires the existing nvtop checkout. Use -DEVEMON_GPU=OFF for a smaller build.")
endif()
set(EVEMON_GPU_VENDOR all CACHE STRING "GPU backend selection: all, nvidia, intel or amd")
set_property(CACHE EVEMON_GPU_VENDOR PROPERTY STRINGS all nvidia intel amd)
if(NOT EVEMON_GPU_VENDOR MATCHES "^(all|nvidia|intel|amd)$")
    message(FATAL_ERROR "EVEMON_GPU_VENDOR must be all, nvidia, intel or amd")
endif()
# Keep vendor registration constructors: these objects must reach the linker
# directly, rather than disappearing as apparently unused archive members.
add_library(evemon_gpu OBJECT
    src/plugins/gpu_nvtop_adapter.c
    ${NVTOP_DIR}/src/extract_gpuinfo.c ${NVTOP_DIR}/src/time.c
    ${NVTOP_DIR}/src/get_process_info_linux.c
    ${NVTOP_DIR}/src/extract_processinfo_fdinfo.c)
set_target_properties(evemon_gpu PROPERTIES AUTOMOC OFF)
if(NOT EVEMON_GPU_VENDOR STREQUAL "nvidia")
    pkg_check_modules(DRM REQUIRED IMPORTED_TARGET libdrm)
    pkg_check_modules(UDEV REQUIRED IMPORTED_TARGET libudev)
    target_sources(evemon_gpu PRIVATE ${NVTOP_DIR}/src/device_discovery_linux.c)
    target_compile_definitions(evemon_gpu PRIVATE USING_LIBUDEV)
    target_link_libraries(evemon_gpu PUBLIC PkgConfig::DRM PkgConfig::UDEV)
endif()
if(EVEMON_GPU_VENDOR STREQUAL "all")
    set(NVTOP_BACKENDS nvidia ascend intel intel_i915 intel_xe msm msm_utils
        panfrost panfrost_utils panthor panthor_utils mali_common v3d v3d_utils tpu metax)
    target_sources(evemon_gpu PRIVATE src/plugins/gpu_dcmi_shim.c
        ${NVTOP_DIR}/src/extract_npuinfo_rockchip.c ${NVTOP_DIR}/src/extract_gcuinfo_enflame.c)
elseif(EVEMON_GPU_VENDOR STREQUAL "intel")
    set(NVTOP_BACKENDS intel intel_i915 intel_xe)
elseif(EVEMON_GPU_VENDOR STREQUAL "nvidia")
    set(NVTOP_BACKENDS nvidia)
else()
    set(NVTOP_BACKENDS)
endif()
if(EVEMON_GPU_VENDOR MATCHES "^(all|amd)$")
    include(CheckIncludeFiles)
    set(CMAKE_REQUIRED_INCLUDES ${DRM_INCLUDE_DIRS})
    check_include_files("libdrm/amdgpu.h;libdrm/amdgpu_drm.h" EVEMON_HAVE_AMDGPU_HEADERS)
    unset(CMAKE_REQUIRED_INCLUDES)
    if(EVEMON_HAVE_AMDGPU_HEADERS)
        list(APPEND NVTOP_BACKENDS amdgpu amdgpu_utils)
    elseif(EVEMON_GPU_VENDOR STREQUAL "amd")
        message(FATAL_ERROR "EVEMON_GPU_VENDOR=amd requires AMD libdrm headers")
    else()
        message(WARNING "AMDGPU backend omitted: AMD libdrm headers unavailable; other GPU backends remain enabled")
    endif()
endif()
foreach(backend IN LISTS NVTOP_BACKENDS)
    target_sources(evemon_gpu PRIVATE ${NVTOP_DIR}/src/extract_gpuinfo_${backend}.c)
endforeach()
target_include_directories(evemon_gpu PRIVATE src/plugins/nvtop_compat ${NVTOP_DIR}/include ${NVTOP_DIR}/src)
target_compile_definitions(evemon_gpu PRIVATE EVEMON_NO_GTK _GNU_SOURCE)
target_compile_options(evemon_gpu PRIVATE -ffunction-sections -fdata-sections)
install(FILES ${NVTOP_DIR}/COPYING DESTINATION ${CMAKE_INSTALL_DATADIR}/evemon/licenses RENAME nvtop-COPYING)
