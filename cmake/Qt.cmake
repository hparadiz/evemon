find_package(Qt6 6.4 REQUIRED COMPONENTS Core Gui Widgets)
add_library(evemon_ui_qt MODULE src/qt/main.cpp src/qt/process_model.cpp
    src/qt/main_window.cpp src/qt/main_menus.cpp src/qt/remote_dialog.cpp src/qt/theme.cpp src/qt/scrollbars.cpp src/qt/about_dialog.cpp src/qt/compatibility_dialog.cpp src/qt/inspector.cpp src/qt/widget_bridge.cpp src/qt/detail_panel.cpp src/qt/write_view.cpp)
target_link_libraries(evemon_ui_qt PRIVATE evemon Qt6::Core Qt6::Gui
    Qt6::Widgets PkgConfig::SQLITE PkgConfig::PANGO)
target_compile_definitions(evemon_ui_qt PRIVATE
    EVEMON_DATADIR="${CMAKE_INSTALL_FULL_DATADIR}/evemon")
qt_add_resources(evemon_ui_qt assets PREFIX "/evemon" FILES icon.png font-logos.ttf)
set(EVEMON_INSPECTORS fd env devices mmap libs threads cgroup system_fd system_libs net gentoo)
if(EVEMON_PIPEWIRE)
    list(APPEND EVEMON_INSPECTORS pipewire audio_service)
endif()
if(EVEMON_GPU)
    list(APPEND EVEMON_INSPECTORS gpu)
endif()
foreach(inspector IN LISTS EVEMON_INSPECTORS)
    add_library(qt_inspector_${inspector} OBJECT src/plugins/${inspector}_plugin.c)
    set_target_properties(qt_inspector_${inspector} PROPERTIES AUTOMOC OFF)
    target_compile_definitions(qt_inspector_${inspector} PRIVATE EVEMON_QT_WIDGETS _GNU_SOURCE evemon_plugin_init=evemon_qt_${inspector}_init)
    target_link_libraries(qt_inspector_${inspector} PRIVATE PkgConfig::GLIB PkgConfig::PANGO)
    target_link_libraries(evemon_ui_qt PRIVATE qt_inspector_${inspector})
endforeach()

if(EVEMON_PIPEWIRE)
    pkg_check_modules(SOUP REQUIRED IMPORTED_TARGET libsoup-3.0)
    add_library(qt_audio_services OBJECT src/media/art_loader.c src/qt/audio_services.c src/ui/pw_meter.c src/ui/spectrogram.c)
    set_target_properties(qt_audio_services PROPERTIES AUTOMOC OFF)
    target_compile_definitions(qt_audio_services PRIVATE EVEMON_QT_WIDGETS HAVE_PIPEWIRE _GNU_SOURCE)
    target_link_libraries(qt_audio_services PRIVATE PkgConfig::GLIB PkgConfig::PIPEWIRE PkgConfig::PANGO PkgConfig::SOUP)
    target_link_libraries(evemon_ui_qt PRIVATE qt_audio_services)
endif()


if(EVEMON_MILKDROP)
    if(NOT EVEMON_PIPEWIRE)
        message(FATAL_ERROR "MilkDrop requires EVEMON_PIPEWIRE=ON for audio capture")
    endif()
    find_package(Qt6 6.4 REQUIRED COMPONENTS OpenGL OpenGLWidgets)
    pkg_check_modules(EPOXY REQUIRED IMPORTED_TARGET epoxy)
    add_library(evemon_qt_milkdrop MODULE src/qt/milkdrop_view.cpp src/plugins/milkdrop_plugin.c)
    target_compile_definitions(evemon_qt_milkdrop PRIVATE EVEMON_NO_GTK EVEMON_QT_MILKDROP _GNU_SOURCE)
    target_link_libraries(evemon_qt_milkdrop PRIVATE evemon Qt6::Widgets Qt6::OpenGLWidgets Qt6::OpenGL PkgConfig::GLIB PkgConfig::EPOXY PkgConfig::PANGO m)
    target_compile_options(evemon_qt_milkdrop PRIVATE -ffunction-sections -fdata-sections)
    target_link_options(evemon_qt_milkdrop PRIVATE -Wl,--as-needed,--gc-sections,-z,relro,-z,now)
    set_target_properties(evemon_qt_milkdrop PROPERTIES LIBRARY_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/plugins-qt" INSTALL_RPATH "$ORIGIN/..")
    target_compile_definitions(evemon_ui_qt PRIVATE HAVE_MILKDROP EVEMON_QT_PLUGIN_DIR="${CMAKE_INSTALL_FULL_LIBDIR}/evemon/plugins-qt")
    add_dependencies(evemon_ui_qt evemon_qt_milkdrop)
    install(TARGETS evemon_qt_milkdrop LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}/evemon/plugins-qt)
endif()

target_compile_definitions(evemon_ui_qt PRIVATE EVEMON_NO_GTK)
set_target_properties(evemon_ui_qt PROPERTIES PREFIX "" OUTPUT_NAME "evemon-ui-qt" INSTALL_RPATH "$ORIGIN")
if(EVEMON_GPU)
    target_compile_definitions(evemon_ui_qt PRIVATE HAVE_NVTOP)
endif()
install(TARGETS evemon_ui_qt LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}/evemon)

target_sources(qt_inspector_net PRIVATE src/plugins/net_chart.c)
if(EVEMON_PIPEWIRE)
    target_sources(qt_inspector_pipewire PRIVATE src/plugins/pipewire_view.c)
endif()
if(EVEMON_MILKDROP)
    target_sources(evemon_qt_milkdrop PRIVATE ${EVEMON_MILKDROP_SOURCES})
endif()


find_package(KF6WindowSystem QUIET)
if(TARGET KF6::WindowSystem)
    target_link_libraries(evemon_ui_qt PRIVATE KF6::WindowSystem)
    target_compile_definitions(evemon_ui_qt PRIVATE HAVE_KWINDOWSYSTEM)
endif()
find_package(KF6ColorScheme QUIET)
if(TARGET KF6::ColorScheme)
    target_link_libraries(evemon_ui_qt PRIVATE KF6::ColorScheme)
    target_compile_definitions(evemon_ui_qt PRIVATE HAVE_KCOLORSCHEME)
endif()
