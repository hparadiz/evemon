pkg_check_modules(GTK REQUIRED IMPORTED_TARGET gtk+-3.0 fontconfig x11)
pkg_check_modules(SOURCEVIEW REQUIRED IMPORTED_TARGET gtksourceview-4)
find_program(GLIB_COMPILE_RESOURCES glib-compile-resources REQUIRED)
add_custom_command(OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/evemon_resources.c
    COMMAND ${GLIB_COMPILE_RESOURCES} --sourcedir=${CMAKE_CURRENT_SOURCE_DIR}/src --generate-source
        --target=${CMAKE_CURRENT_BINARY_DIR}/evemon_resources.c ${CMAKE_CURRENT_SOURCE_DIR}/src/ui/evemon.gresource.xml
    DEPENDS src/ui/evemon.gresource.xml icon.png font-logos.ttf VERBATIM)
file(GLOB GTK_UI_SOURCES CONFIGURE_DEPENDS src/ui/*.c)
list(FILTER GTK_UI_SOURCES EXCLUDE REGEX "/(devices|pipewire_scan|fd_scan|env_scan|mmap_scan|lib_scan|net_scan)\\.c$")
add_library(evemon_ui_gtk MODULE ${GTK_UI_SOURCES} ${CMAKE_CURRENT_BINARY_DIR}/evemon_resources.c)
target_link_libraries(evemon_ui_gtk PRIVATE evemon PkgConfig::GTK PkgConfig::PANGO)
pkg_check_modules(GTK_WAYLAND QUIET IMPORTED_TARGET gdk-wayland-3.0 wayland-client)
find_program(WAYLAND_SCANNER wayland-scanner)
find_file(BACKGROUND_EFFECT_PROTOCOL ext-background-effect-v1.xml
    PATH_SUFFIXES wayland-protocols/staging/ext-background-effect
    PATHS /usr/share /usr/local/share)
if(GTK_WAYLAND_FOUND AND WAYLAND_SCANNER AND BACKGROUND_EFFECT_PROTOCOL)
    set(BLUR_HEADER ${CMAKE_CURRENT_BINARY_DIR}/evemon-background-effect-client.h)
    set(BLUR_CODE ${CMAKE_CURRENT_BINARY_DIR}/evemon-background-effect-protocol.c)
    add_custom_command(OUTPUT ${BLUR_HEADER} ${BLUR_CODE}
        COMMAND ${WAYLAND_SCANNER} client-header ${BACKGROUND_EFFECT_PROTOCOL} ${BLUR_HEADER}
        COMMAND ${WAYLAND_SCANNER} private-code ${BACKGROUND_EFFECT_PROTOCOL} ${BLUR_CODE}
        DEPENDS ${BACKGROUND_EFFECT_PROTOCOL} VERBATIM)
    target_sources(evemon_ui_gtk PRIVATE ${BLUR_HEADER} ${BLUR_CODE})
    target_include_directories(evemon_ui_gtk PRIVATE ${CMAKE_CURRENT_BINARY_DIR})
    target_link_libraries(evemon_ui_gtk PRIVATE PkgConfig::GTK_WAYLAND)
    target_compile_definitions(evemon_ui_gtk PRIVATE HAVE_GTK_WAYLAND_BLUR)
endif()
set_target_properties(evemon_ui_gtk PROPERTIES PREFIX "" OUTPUT_NAME "evemon-ui-gtk" INSTALL_RPATH "$ORIGIN")
install(TARGETS evemon_ui_gtk LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}/evemon)
set(GTK_PLUGINS fd env devices mmap libs threads cgroup system_fd system_libs net gentoo proc_meta_service write_monitor write_monitor_ui)
if(EVEMON_PIPEWIRE)
    list(APPEND GTK_PLUGINS pipewire audio_service)
endif()
if(EVEMON_MILKDROP)
    list(APPEND GTK_PLUGINS milkdrop)
endif()
if(EVEMON_GPU)
    list(APPEND GTK_PLUGINS gpu)
endif()
foreach(plugin IN LISTS GTK_PLUGINS)
    add_library(gtk_plugin_${plugin} MODULE src/plugins/${plugin}_plugin.c)
    target_link_libraries(gtk_plugin_${plugin} PRIVATE evemon PkgConfig::GTK PkgConfig::PANGO)
    set_target_properties(gtk_plugin_${plugin} PROPERTIES PREFIX "" OUTPUT_NAME "evemon_${plugin}_plugin"
        LIBRARY_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/plugins" INSTALL_RPATH "$ORIGIN/..")
    install(TARGETS gtk_plugin_${plugin} LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}/evemon/plugins)
endforeach()
target_link_libraries(gtk_plugin_proc_meta_service PRIVATE PkgConfig::SQLITE)
target_link_libraries(gtk_plugin_write_monitor_ui PRIVATE PkgConfig::SOURCEVIEW)
if(EVEMON_PIPEWIRE)
    target_sources(gtk_plugin_audio_service PRIVATE src/media/art_loader.c)
    target_link_libraries(gtk_plugin_audio_service PRIVATE PkgConfig::SOUP)
endif()
if(EVEMON_MILKDROP)
    target_link_libraries(gtk_plugin_milkdrop PRIVATE PkgConfig::EPOXY)
endif()

target_sources(gtk_plugin_net PRIVATE src/plugins/net_chart.c)
if(EVEMON_PIPEWIRE)
    target_sources(gtk_plugin_pipewire PRIVATE src/plugins/pipewire_view.c)
endif()
if(EVEMON_MILKDROP)
    target_sources(gtk_plugin_milkdrop PRIVATE ${EVEMON_MILKDROP_SOURCES})
endif()

