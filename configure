#!/bin/sh
set -eu

src_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
build_dir="$src_dir/build"
prefix=/usr/local
libdir_arg=
gtk=ON
qt=ON
selected=no
pipewire=ON
milkdrop=ON
gpu_arg=
android_arg=
ebpf=ON
lto=OFF
default_ui=
build_type=RelWithDebInfo
for arg in "$@"; do
    case "$arg" in
        --with-qt|--with-gtk)
            if [ "$selected" = no ]; then gtk=OFF; qt=OFF; selected=yes; fi
            case "$arg" in --with-qt) qt=ON;; --with-gtk) gtk=ON;; esac ;;
        --without-qt) qt=OFF ;;
        --without-gtk) gtk=OFF ;;
        --without-pipewire) pipewire=OFF; milkdrop=OFF ;;
        --with-pipewire) pipewire=ON ;;
        --without-milkdrop) milkdrop=OFF ;;
        --with-milkdrop) milkdrop=ON ;;
        --without-gpu) gpu_arg=-DEVEMON_GPU=OFF ;;
        --with-gpu) gpu_arg=-DEVEMON_GPU=ON ;;
        --without-android) android_arg=-DEVEMON_ANDROID=OFF ;;
        --with-android) android_arg=-DEVEMON_ANDROID=ON ;;
        --without-ebpf) ebpf=OFF ;;
        --with-ebpf) ebpf=ON ;;
        --enable-lto) lto=ON ;;
        --disable-lto) lto=OFF ;;
        --enable-debug) build_type=Debug ;;
        --prefix=*) prefix=${arg#*=} ;;
        --libdir=*) libdir_arg="-DCMAKE_INSTALL_LIBDIR=${arg#*=}" ;;
        --build-dir=*) build_dir=${arg#*=} ;;
        --with-default-ui=*) default_ui=${arg#*=} ;;
        --help|-h)
            cat <<'HELP'
Usage: ./configure [OPTIONS]
  --with-qt                 Build Qt 6 frontend only
  --with-gtk                Build GTK 3 frontend only
  --without-qt --without-gtk  Build only the headless executable
  --with-default-ui=gtk|qt|headless  Initial default (saved preference overrides)
  --without-pipewire        Disable audio and MilkDrop
  --without-milkdrop        Disable visualization
  --without-gpu             Disable nvtop GPU support
  --with-gpu                Require the nvtop checkout (default: use if present)
  --without-android         Omit the Android runtime bundle
  --with-android            Require the Android archive (default: use if present)
  --without-ebpf            Disable eBPF tracing and kernel program compilation
  --enable-debug            Debug build
  --enable-lto              Link-time optimization
  --prefix=PATH             Install prefix (default /usr/local)
  --libdir=PATH             Library directory name (for example lib or lib64)
  --build-dir=PATH          Build directory (default ./build)
Then: make [BUILD_DIR=PATH] [-jN], make install [DESTDIR=PATH]
Both --with-qt and --with-gtk build one executable with selectable UI modules.
Without UI flags, both frontends are built. Plain make needs no configure step.
HELP
            exit 0 ;;
        *) printf 'configure: unknown option: %s\n' "$arg" >&2; exit 2 ;;
    esac
done
exec cmake -S "$src_dir" -B "$build_dir" -DCMAKE_INSTALL_PREFIX="$prefix" \
    $libdir_arg \
    -DCMAKE_BUILD_TYPE="$build_type" -DEVEMON_GTK="$gtk" -DEVEMON_QT="$qt" \
    -DEVEMON_PIPEWIRE="$pipewire" -DEVEMON_MILKDROP="$milkdrop" \
    ${gpu_arg:+"$gpu_arg"} ${android_arg:+"$android_arg"} \
    -DEVEMON_EBPF="$ebpf" \
    -DEVEMON_LTO="$lto" -DEVEMON_DEFAULT_UI="$default_ui"
